{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "None",
      "Microsoft.AspNetCore.Routing": "None",
      "Microsoft.AspNetCore.Mvc": "Warning",
      "transdb_geocoding": "Information"
    }
  },
  "AllowedHosts": "*",
  
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "geocoding"
  },
  
  "ApiKeys": {
    "Directory": "/app/keys"
  },
  
  "Cache": {
    "Ttl": "01:00:00"
  },

  "GeoData": {
    "DataDirectory": "./geodata",
    "PlacesUrl": "https://download.geonames.org/export/dump/{code}.zip",
    "PostalCodesUrl": "https://download.geonames.org/export/zip/{code}.zip",
    "Countries": [ "DE", "AT", "CH", "BE", "NL" ]
  }
}
